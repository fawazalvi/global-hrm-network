# ==============================================================================
# Global HRM Network - Environment Variables Example
# Copy this file to .env.local (for local development) and never commit secrets.
# In Coolify, configure these in the application's Environment Variables UI.
# ==============================================================================

# --- PostgreSQL Database Connection (Required at Runtime) ---
# Production (Coolify private network):
#   postgresql://global_hrm_app:URL_ENCODED_PASSWORD@INTERNAL_POSTGRES_HOST:5432/global_hrm?sslmode=prefer&connection_limit=10
# Local development:
DATABASE_URL="postgresql://global_hrm_dev:CHANGE_ME@localhost:5432/global_hrm_dev?connection_limit=5"

# Optional separate migration connection if using a restricted runtime role vs. migration role:
# MIGRATION_DATABASE_URL="postgresql://global_hrm_migrator:URL_ENCODED_PASSWORD@INTERNAL_POSTGRES_HOST:5432/global_hrm?sslmode=prefer"

# --- NextAuth.js / Auth.js (Required at Runtime) ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="CHANGE_ME_GENERATE_32_BYTE_SECRET"
NEXTAUTH_URL="http://localhost:3000"

# --- Optional OAuth (Google) ---
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# --- Optional AI / Email Integrations ---
# GEMINI_API_KEY=""
# GMAIL_IMPERSONATED_USER_EMAIL="memberships@global-hrm.net"
# GMAIL_SERVICE_ACCOUNT_KEY=""
# LINKEDIN_SCRAPER_API_KEY=""
