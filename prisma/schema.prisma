datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String         @id @default(uuid())
  fullName        String
  email           String         @unique
  password        String?        // Hashed password for CredentialsProvider (nullable for OAuth users)
  profilePhotoURL String?
  role            String         @default("user") // "user" | "admin" | "moderator"
  accountStatus   String         @default("pending") // "active" | "suspended" | "pending"
  emailVerified   Boolean        @default(false)
  createdAt       DateTime       @default(now())
  lastLogin       DateTime       @default(now())

  // Relations
  profile         Profile?
  achievements    Achievement[]
  subscriptions   Subscription[]
  adminLogs       AdminLog[]     @relation("AdminAction")
  targetLogs      AdminLog[]     @relation("AdminTarget")

  // NextAuth relations
  accounts        Account[]
  sessions        Session[]
}

model Account {
  id                 String  @id @default(uuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Profile {
  id                 String   @id @default(uuid())
  userId             String   @unique
  headline           String?
  summary            String?  @db.Text
  yearsOfExperience  Int      @default(0)
  industries         String?  @db.Text // Array of strings (JSON)
  skills             String?  @db.Text // Array of strings (JSON)
  certifications     String?  @db.Text // Array of strings (JSON)
  employmentHistory  String?  @db.Text // Array of strings (JSON)
  education          String?  @db.Text // Array of strings (JSON)
  country            String?
  visibility         String   @default("public") // "public" | "private"
  verificationStatus String   @default("unverified") // "unverified" | "verified" | "rejected" | "pending"
  profileScore       Int      @default(0)
  updatedAt          DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Achievement {
  id          String   @id @default(uuid())
  userId      String
  title       String
  description String   @db.Text
  year        Int
  proofURL    String?
  verified    Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subscription {
  id              String   @id @default(uuid())
  userId          String
  plan            String   // "free" | "pro" | "enterprise"
  status          String   // "active" | "canceled" | "expired"
  startDate       DateTime @default(now())
  endDate         DateTime
  paymentProvider String   @default("Stripe")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AdminLog {
  id           String   @id @default(uuid())
  adminId      String
  action       String
  targetUserId String
  timestamp    DateTime @default(now())
  remarks      String?  @db.Text

  admin      User @relation("AdminAction", fields: [adminId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  targetUser User @relation("AdminTarget", fields: [targetUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Application {
  id                     String   @id @default(uuid())
  fullName               String
  email                  String   @unique
  currentRole            String
  yearsOfExperience      Int
  linkedinUrl            String
  expertise              String?  @db.Text // Array of strings (JSON)
  interest               String
  status                 String   @default("pending") // "pending" | "approved" | "rejected"
  submittedAt            DateTime @default(now())
  profileScore           Int?
  relevanceScore         Int?
  profileScoreFeedback   String?  @db.Text
  relevanceScoreFeedback String?  @db.Text
  assessments            String?  @db.Text // Nested JSON structure
  approvedUserId         String?
}

model HRExpertise {
  id   String @id @default(uuid())
  name String @unique
}

model GlobalConfig {
  id      String @id @default("global")
  logoUrl String
}

// ============================================================================
// Pakistan Banking Expertise Map & Multi-Campaign Survey Models
// ============================================================================

model InstitutionCategory {
  id               String   @id @default(uuid())
  code             String   @unique
  name             String
  shortLabel       String
  description      String?  @db.Text
  displayOrder     Int      @default(0)
  isCommercialBank Boolean  @default(false)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  institutions     Institution[]
  campaignSettings CampaignInstitutionCategory[]

  @@index([isActive, displayOrder])
}

model CampaignInstitutionCategory {
  id         String  @id @default(uuid())
  campaignId String
  categoryId String
  isEnabled  Boolean @default(true)

  campaign SurveyCampaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  category InstitutionCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([campaignId, categoryId])
}

model Institution {
  id                     String    @id @default(uuid())
  code                   String?   @unique
  name                   String
  normalizedName         String    @unique
  shortCode              String?
  categoryId             String?
  operatingStatus        String    @default("active") // "active" | "restricted_pilot" | "in_principle_prelaunch" | "merged" | "liquidated_cancelled" | "other_placeholder"
  statusNote             String?   @db.Text
  isSelectable           Boolean   @default(true)
  isHistorical           Boolean   @default(false)
  successorInstitutionId String?
  sourceUrl              String?
  lastVerifiedAt         DateTime?
  displayOrder           Int       @default(0)
  country                String    @default("Pakistan")
  isActive               Boolean   @default(true)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  category             InstitutionCategory?     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  successorInstitution Institution?             @relation("InstitutionSuccessor", fields: [successorInstitutionId], references: [id], onDelete: SetNull)
  predecessors         Institution[]            @relation("InstitutionSuccessor")
  aliases              InstitutionAlias[]
  emailDomains         InstitutionEmailDomain[]
  participants         SurveyParticipant[]
  submissions          SurveySubmission[]

  @@index([isActive, isSelectable, isHistorical])
  @@index([categoryId, displayOrder])
}

model InstitutionAlias {
  id              String   @id @default(uuid())
  institutionId   String
  alias           String
  normalizedAlias String
  aliasType       String   @default("abbreviation") // "former_name" | "abbreviation" | "brand_alias"
  createdAt       DateTime @default(now())

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@unique([institutionId, normalizedAlias])
  @@index([normalizedAlias])
}

model InstitutionEmailDomain {
  id            String   @id @default(uuid())
  institutionId String
  domain        String
  isVerified    Boolean  @default(true)
  createdAt     DateTime @default(now())

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@unique([institutionId, domain])
  @@index([domain])
}

model SurveyCampaign {
  id          String    @id @default(uuid())
  slug        String    @unique
  title       String
  description String?   @db.Text
  status      String    @default("active") // "draft" | "active" | "closed"
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  submissions           SurveySubmission[]
  referralLinks         ReferralLink[]
  referralInvitations   ReferralInvitation[]
  institutionCategories CampaignInstitutionCategory[]
  choiceAvailability    CampaignChoiceAvailability[]

  @@index([status])
}

model SurveyChoiceSet {
  id          String   @id @default(uuid())
  code        String   @unique // e.g. "cities"
  name        String
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  choices SurveyChoice[]
}

model SurveyChoice {
  id            String   @id @default(uuid())
  choiceSetId   String
  code          String
  label         String
  description   String?  @db.Text
  aliases       String?  @db.Text // Comma/semicolon-separated searchable aliases
  displayOrder  Int      @default(0)
  isActive      Boolean  @default(true)
  isOtherOption Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  choiceSet            SurveyChoiceSet              @relation(fields: [choiceSetId], references: [id], onDelete: Cascade)
  campaignAvailability CampaignChoiceAvailability[]
  cityParticipants     SurveyParticipant[]          @relation("ParticipantCity")
  citySubmissions      SurveySubmission[]           @relation("SubmissionCity")

  @@unique([choiceSetId, code])
  @@index([choiceSetId, isActive, displayOrder])
}

model CampaignChoiceAvailability {
  id                   String  @id @default(uuid())
  campaignId           String
  choiceId             String?
  expertiseCategoryId  String?
  engagementInterestId String?
  isEnabled            Boolean @default(true)

  campaign           SurveyCampaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  choice             SurveyChoice?       @relation(fields: [choiceId], references: [id], onDelete: Cascade)
  expertiseCategory  ExpertiseCategory?  @relation(fields: [expertiseCategoryId], references: [id], onDelete: Cascade)
  engagementInterest EngagementInterest? @relation(fields: [engagementInterestId], references: [id], onDelete: Cascade)

  @@unique([campaignId, choiceId])
  @@unique([campaignId, expertiseCategoryId])
  @@unique([campaignId, engagementInterestId])
}

model ExpertiseCategory {
  id            String   @id @default(uuid())
  slug          String   @unique
  name          String
  description   String?  @db.Text
  displayOrder  Int      @default(0)
  isActive      Boolean  @default(true)
  isOtherOption Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  rankedSelections     SurveyRankedExpertise[]
  campaignAvailability CampaignChoiceAvailability[]

  @@index([isActive, displayOrder])
}

model EngagementInterest {
  id           String   @id @default(uuid())
  slug         String   @unique
  label        String
  description  String?  @db.Text
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  submissions          SurveySubmissionInterest[]
  campaignAvailability CampaignChoiceAvailability[]

  @@index([isActive, displayOrder])
}

model SurveyParticipant {
  id                          String    @id @default(uuid())
  preferredName               String
  officialEmail               String
  normalizedEmail             String    @unique
  institutionId               String
  designation                 String
  organizationalGrade         String?
  city                        String?
  cityId                      String?
  totalBankingExperienceYears Decimal   @db.Decimal(4, 1)
  experienceOverview          String?   @db.Text
  emailVerified               Boolean   @default(false)
  emailVerifiedAt             DateTime?
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  institution    Institution        @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  cityChoice     SurveyChoice?      @relation("ParticipantCity", fields: [cityId], references: [id], onDelete: SetNull)
  submissions    SurveySubmission[]
  consentRecords ConsentRecord[]
  referralLinks  ReferralLink[]

  @@index([institutionId])
  @@index([emailVerified])
}

model SurveySubmission {
  id                          String    @id @default(uuid())
  campaignId                  String
  participantId               String?
  institutionId               String
  institutionNameRaw          String
  institutionNameSnapshot     String?
  otherInstitutionText        String?   @db.Text
  preferredName               String
  designation                 String
  organizationalGrade         String?
  officialEmail               String
  normalizedEmail             String
  city                        String?
  cityId                      String?
  cityNameSnapshot            String?
  totalBankingExperienceYears Decimal   @db.Decimal(4, 1)
  experienceOverview          String?   @db.Text
  otherExpertiseText          String?   @db.Text
  status                      String    @default("pending_verification") // "pending_verification" | "verified" | "withdrawn"
  referralAttribution         String?
  referralLinkId              String?
  submittedAt                 DateTime  @default(now())
  verifiedAt                  DateTime?
  updatedAt                   DateTime  @updatedAt

  campaign           SurveyCampaign             @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  participant        SurveyParticipant?         @relation(fields: [participantId], references: [id], onDelete: SetNull)
  institution        Institution                @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  cityChoice         SurveyChoice?              @relation("SubmissionCity", fields: [cityId], references: [id], onDelete: SetNull)
  referralLink       ReferralLink?              @relation(fields: [referralLinkId], references: [id], onDelete: SetNull)
  rankedExpertise    SurveyRankedExpertise[]
  interests          SurveySubmissionInterest[]
  consentRecords     ConsentRecord[]
  verificationTokens SurveyVerificationToken[]
  otherProposals     SurveyOtherProposal[]

  @@unique([campaignId, normalizedEmail])
  @@index([campaignId, status])
  @@index([participantId])
  @@index([normalizedEmail])
}

model SurveyRankedExpertise {
  id                   String  @id @default(uuid())
  submissionId         String
  categoryId           String
  categoryNameSnapshot String?
  rank                 Int     // 1, 2, or 3

  submission SurveySubmission  @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  category   ExpertiseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([submissionId, rank])
  @@unique([submissionId, categoryId])
  @@index([categoryId])
}

model SurveySubmissionInterest {
  id                    String  @id @default(uuid())
  submissionId          String
  interestId            String
  interestLabelSnapshot String?

  submission SurveySubmission   @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  interest   EngagementInterest @relation(fields: [interestId], references: [id], onDelete: Restrict)

  @@unique([submissionId, interestId])
  @@index([interestId])
}

model SurveyOtherProposal {
  id                  String    @id @default(uuid())
  submissionId        String
  proposalType        String    // "institution" | "expertise" | "city"
  submittedText       String    @db.Text
  status              String    @default("pending") // "pending" | "approved_new" | "mapped_existing" | "rejected"
  mappedInstitutionId String?
  mappedExpertiseId   String?
  mappedChoiceId      String?
  reviewedByAdminId   String?
  reviewedAt          DateTime?
  reviewNotes         String?   @db.Text
  createdAt           DateTime  @default(now())

  submission SurveySubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([status, proposalType])
  @@index([submissionId])
}

model ChoiceAuditLog {
  id                   String   @id @default(uuid())
  adminUserId          String
  adminEmail           String
  entityType           String   // "institution" | "institution_category" | "expertise_category" | "engagement_interest" | "choice_set_item" | "other_proposal" | "csv_import"
  entityId             String
  action               String   // "create" | "update" | "deactivate" | "activate" | "delete" | "reorder" | "campaign_toggle" | "merge_execute" | "proposal_resolve" | "csv_import"
  changeClassification String   @default("minor_label") // "minor_label" | "material_meaning" | "lifecycle" | "config"
  beforeValue          String?  @db.Text
  afterValue           String?  @db.Text
  notes                String?  @db.Text
  createdAt            DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

model ConsentRecord {
  id            String   @id @default(uuid())
  submissionId  String
  participantId String?
  consentType   String   // "participation" | "communications"
  granted       Boolean
  policyVersion String   @default("v1.0")
  capturedAt    DateTime @default(now())
  ipHash        String?

  submission  SurveySubmission   @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  participant SurveyParticipant? @relation(fields: [participantId], references: [id], onDelete: SetNull)

  @@unique([submissionId, consentType])
  @@index([participantId, consentType])
}

model SurveyVerificationToken {
  id              String    @id @default(uuid())
  submissionId    String
  normalizedEmail String
  tokenHash       String    @unique // SHA-256 hex digest; raw token is never persisted
  expiresAt       DateTime
  consumedAt      DateTime?
  createdAt       DateTime  @default(now())

  submission SurveySubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@index([expiresAt])
}

model ReferralLink {
  id                     String   @id @default(uuid())
  code                   String   @unique
  campaignId             String
  createdByParticipantId String?
  label                  String?
  isActive               Boolean  @default(true)
  createdAt              DateTime @default(now())

  campaign    SurveyCampaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  createdBy   SurveyParticipant?   @relation(fields: [createdByParticipantId], references: [id], onDelete: SetNull)
  submissions SurveySubmission[]
  invitations ReferralInvitation[]

  @@unique([campaignId, createdByParticipantId])
  @@index([campaignId, isActive])
}

model ReferralInvitation {
  id                   String    @id @default(uuid())
  referralLinkId       String
  campaignId           String
  invitedPreferredName String?
  invitedEmail         String
  normalizedEmail      String
  status               String    @default("sent") // "sent" | "accepted" | "expired" | "suppressed" | "failed"
  invitedAt            DateTime  @default(now())
  acceptedAt           DateTime?

  referralLink ReferralLink   @relation(fields: [referralLinkId], references: [id], onDelete: Cascade)
  campaign     SurveyCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, normalizedEmail])
  @@index([referralLinkId])
}

model EmailSuppression {
  id              String   @id @default(uuid())
  normalizedEmail String   @unique
  reason          String   // "unsubscribed" | "bounced" | "complaint" | "manual"
  source          String?
  suppressedAt    DateTime @default(now())
}
