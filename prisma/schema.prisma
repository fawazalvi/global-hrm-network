datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String         @id @default(uuid())
  fullName        String
  email           String         @unique
  password        String?        // Hashed password for CredentialsProvider (nullable for OAuth users)
  profilePhotoURL String?
  role            String         @default("user") // "user" | "admin" | "moderator"
  accountStatus   String         @default("pending") // "active" | "suspended" | "pending"
  emailVerified   Boolean        @default(false)
  createdAt       DateTime       @default(now())
  lastLogin       DateTime       @default(now())

  // Relations
  profile         Profile?
  achievements    Achievement[]
  subscriptions   Subscription[]
  adminLogs       AdminLog[]     @relation("AdminAction")
  targetLogs      AdminLog[]     @relation("AdminTarget")

  // NextAuth relations
  accounts        Account[]
  sessions        Session[]
}

model Account {
  id                 String  @id @default(uuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Profile {
  id                 String   @id @default(uuid())
  userId             String   @unique
  headline           String?
  summary            String?  @db.Text
  yearsOfExperience  Int      @default(0)
  industries         String?  @db.Text // Array of strings (JSON)
  skills             String?  @db.Text // Array of strings (JSON)
  certifications     String?  @db.Text // Array of strings (JSON)
  employmentHistory  String?  @db.Text // Array of strings (JSON)
  education          String?  @db.Text // Array of strings (JSON)
  country            String?
  visibility         String   @default("public") // "public" | "private"
  verificationStatus String   @default("unverified") // "unverified" | "verified" | "rejected" | "pending"
  profileScore       Int      @default(0)
  updatedAt          DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Achievement {
  id          String   @id @default(uuid())
  userId      String
  title       String
  description String   @db.Text
  year        Int
  proofURL    String?
  verified    Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subscription {
  id              String   @id @default(uuid())
  userId          String
  plan            String   // "free" | "pro" | "enterprise"
  status          String   // "active" | "canceled" | "expired"
  startDate       DateTime @default(now())
  endDate         DateTime
  paymentProvider String   @default("Stripe")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AdminLog {
  id           String   @id @default(uuid())
  adminId      String
  action       String
  targetUserId String
  timestamp    DateTime @default(now())
  remarks      String?  @db.Text

  admin      User @relation("AdminAction", fields: [adminId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  targetUser User @relation("AdminTarget", fields: [targetUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Application {
  id                     String   @id @default(uuid())
  fullName               String
  email                  String   @unique
  currentRole            String
  yearsOfExperience      Int
  linkedinUrl            String
  expertise              String?  @db.Text // Array of strings (JSON)
  interest               String
  status                 String   @default("pending") // "pending" | "approved" | "rejected"
  submittedAt            DateTime @default(now())
  profileScore           Int?
  relevanceScore         Int?
  profileScoreFeedback   String?  @db.Text
  relevanceScoreFeedback String?  @db.Text
  assessments            String?  @db.Text // Nested JSON structure
  approvedUserId         String?
}

model HRExpertise {
  id   String @id @default(uuid())
  name String @unique
}

model GlobalConfig {
  id      String @id @default("global")
  logoUrl String
}

// ============================================================================
// Pakistan Banking Expertise Map & Multi-Campaign Survey Models
// ============================================================================

model InstitutionCategory {
  id               String   @id @default(uuid())
  code             String   @unique
  name             String
  shortLabel       String
  description      String?  @db.Text
  displayOrder     Int      @default(0)
  isCommercialBank Boolean  @default(false)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  institutions     Institution[]
  campaignSettings CampaignInstitutionCategory[]

  @@index([isActive, displayOrder])
}

model CampaignInstitutionCategory {
  id         String  @id @default(uuid())
  campaignId String
  categoryId String
  isEnabled  Boolean @default(true)

  campaign SurveyCampaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  category InstitutionCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([campaignId, categoryId])
}

model Institution {
  id                     String    @id @default(uuid())
  code                   String?   @unique
  name                   String
  normalizedName         String    @unique
  shortCode              String?
  categoryId             String?
  operatingStatus        String    @default("active") // "active" | "restricted_pilot" | "in_principle_prelaunch" | "merged" | "liquidated_cancelled" | "other_placeholder"
  statusNote             String?   @db.Text
  isSelectable           Boolean   @default(true)
  isHistorical           Boolean   @default(false)
  successorInstitutionId String?
  sourceUrl              String?
  lastVerifiedAt         DateTime?
  displayOrder           Int       @default(0)
  country                String    @default("Pakistan")
  isActive               Boolean   @default(true)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  category             InstitutionCategory?     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  successorInstitution Institution?             @relation("InstitutionSuccessor", fields: [successorInstitutionId], references: [id], onDelete: SetNull)
  predecessors         Institution[]            @relation("InstitutionSuccessor")
  aliases              InstitutionAlias[]
  emailDomains         InstitutionEmailDomain[]
  participants         SurveyParticipant[]
  submissions          SurveySubmission[]
  leadContacts         LeadContact[]

  @@index([isActive, isSelectable, isHistorical])
  @@index([categoryId, displayOrder])
}

model InstitutionAlias {
  id              String   @id @default(uuid())
  institutionId   String
  alias           String
  normalizedAlias String
  aliasType       String   @default("abbreviation") // "former_name" | "abbreviation" | "brand_alias"
  createdAt       DateTime @default(now())

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@unique([institutionId, normalizedAlias])
  @@index([normalizedAlias])
}

model InstitutionEmailDomain {
  id            String   @id @default(uuid())
  institutionId String
  domain        String
  isVerified    Boolean  @default(true)
  createdAt     DateTime @default(now())

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@unique([institutionId, domain])
  @@index([domain])
}

model SurveyCampaign {
  id          String    @id @default(uuid())
  slug        String    @unique
  title       String
  description String?   @db.Text
  status      String    @default("active") // "draft" | "active" | "closed"
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  submissions           SurveySubmission[]
  referralLinks         ReferralLink[]
  referralInvitations   ReferralInvitation[]
  institutionCategories CampaignInstitutionCategory[]
  choiceAvailability    CampaignChoiceAvailability[]
  leadMemberships       LeadCampaignMembership[]

  @@index([status])
}

model SurveyChoiceSet {
  id          String   @id @default(uuid())
  code        String   @unique // e.g. "cities"
  name        String
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  choices SurveyChoice[]
}

model SurveyChoice {
  id            String   @id @default(uuid())
  choiceSetId   String
  code          String
  label         String
  description   String?  @db.Text
  aliases       String?  @db.Text // Comma/semicolon-separated searchable aliases
  displayOrder  Int      @default(0)
  isActive      Boolean  @default(true)
  isOtherOption Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  choiceSet            SurveyChoiceSet              @relation(fields: [choiceSetId], references: [id], onDelete: Cascade)
  campaignAvailability CampaignChoiceAvailability[]
  cityParticipants     SurveyParticipant[]          @relation("ParticipantCity")
  citySubmissions      SurveySubmission[]           @relation("SubmissionCity")

  @@unique([choiceSetId, code])
  @@index([choiceSetId, isActive, displayOrder])
}

model CampaignChoiceAvailability {
  id                   String  @id @default(uuid())
  campaignId           String
  choiceId             String?
  expertiseCategoryId  String?
  engagementInterestId String?
  isEnabled            Boolean @default(true)

  campaign           SurveyCampaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  choice             SurveyChoice?       @relation(fields: [choiceId], references: [id], onDelete: Cascade)
  expertiseCategory  ExpertiseCategory?  @relation(fields: [expertiseCategoryId], references: [id], onDelete: Cascade)
  engagementInterest EngagementInterest? @relation(fields: [engagementInterestId], references: [id], onDelete: Cascade)

  @@unique([campaignId, choiceId])
  @@unique([campaignId, expertiseCategoryId])
  @@unique([campaignId, engagementInterestId])
}

model ExpertiseCategory {
  id            String   @id @default(uuid())
  slug          String   @unique
  name          String
  description   String?  @db.Text
  displayOrder  Int      @default(0)
  isActive      Boolean  @default(true)
  isOtherOption Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  rankedSelections     SurveyRankedExpertise[]
  campaignAvailability CampaignChoiceAvailability[]

  @@index([isActive, displayOrder])
}

model EngagementInterest {
  id           String   @id @default(uuid())
  slug         String   @unique
  label        String
  description  String?  @db.Text
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  submissions          SurveySubmissionInterest[]
  campaignAvailability CampaignChoiceAvailability[]

  @@index([isActive, displayOrder])
}

model SurveyParticipant {
  id                          String    @id @default(uuid())
  preferredName               String
  officialEmail               String
  normalizedEmail             String    @unique
  institutionId               String
  designation                 String
  organizationalGrade         String?
  city                        String?
  cityId                      String?
  totalBankingExperienceYears Decimal   @db.Decimal(4, 1)
  experienceOverview          String?   @db.Text
  emailVerified               Boolean   @default(false)
  emailVerifiedAt             DateTime?
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  institution    Institution        @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  cityChoice     SurveyChoice?      @relation("ParticipantCity", fields: [cityId], references: [id], onDelete: SetNull)
  submissions    SurveySubmission[]
  consentRecords ConsentRecord[]
  referralLinks  ReferralLink[]

  @@index([institutionId])
  @@index([emailVerified])
}

model SurveySubmission {
  id                          String    @id @default(uuid())
  campaignId                  String
  participantId               String?
  institutionId               String
  institutionNameRaw          String
  institutionNameSnapshot     String?
  otherInstitutionText        String?   @db.Text
  preferredName               String
  designation                 String
  organizationalGrade         String?
  officialEmail               String
  normalizedEmail             String
  city                        String?
  cityId                      String?
  cityNameSnapshot            String?
  totalBankingExperienceYears Decimal   @db.Decimal(4, 1)
  experienceOverview          String?   @db.Text
  otherExpertiseText          String?   @db.Text
  status                      String    @default("pending_verification") // "pending_verification" | "verified" | "withdrawn"
  referralAttribution         String?
  referralLinkId              String?
  submittedAt                 DateTime  @default(now())
  verifiedAt                  DateTime?
  updatedAt                   DateTime  @updatedAt

  campaign           SurveyCampaign             @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  participant        SurveyParticipant?         @relation(fields: [participantId], references: [id], onDelete: SetNull)
  institution        Institution                @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  cityChoice         SurveyChoice?              @relation("SubmissionCity", fields: [cityId], references: [id], onDelete: SetNull)
  referralLink       ReferralLink?              @relation(fields: [referralLinkId], references: [id], onDelete: SetNull)
  rankedExpertise    SurveyRankedExpertise[]
  interests          SurveySubmissionInterest[]
  consentRecords     ConsentRecord[]
  verificationTokens SurveyVerificationToken[]
  otherProposals     SurveyOtherProposal[]

  @@unique([campaignId, normalizedEmail])
  @@index([campaignId, status])
  @@index([participantId])
  @@index([normalizedEmail])
}

model SurveyRankedExpertise {
  id                   String  @id @default(uuid())
  submissionId         String
  categoryId           String
  categoryNameSnapshot String?
  rank                 Int     // 1, 2, or 3

  submission SurveySubmission  @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  category   ExpertiseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([submissionId, rank])
  @@unique([submissionId, categoryId])
  @@index([categoryId])
}

model SurveySubmissionInterest {
  id                    String  @id @default(uuid())
  submissionId          String
  interestId            String
  interestLabelSnapshot String?

  submission SurveySubmission   @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  interest   EngagementInterest @relation(fields: [interestId], references: [id], onDelete: Restrict)

  @@unique([submissionId, interestId])
  @@index([interestId])
}

model SurveyOtherProposal {
  id                  String    @id @default(uuid())
  submissionId        String
  proposalType        String    // "institution" | "expertise" | "city"
  submittedText       String    @db.Text
  status              String    @default("pending") // "pending" | "approved_new" | "mapped_existing" | "rejected"
  mappedInstitutionId String?
  mappedExpertiseId   String?
  mappedChoiceId      String?
  reviewedByAdminId   String?
  reviewedAt          DateTime?
  reviewNotes         String?   @db.Text
  createdAt           DateTime  @default(now())

  submission SurveySubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([status, proposalType])
  @@index([submissionId])
}

model ChoiceAuditLog {
  id                   String   @id @default(uuid())
  adminUserId          String
  adminEmail           String
  entityType           String   // "institution" | "institution_category" | "expertise_category" | "engagement_interest" | "choice_set_item" | "other_proposal" | "csv_import"
  entityId             String
  action               String   // "create" | "update" | "deactivate" | "activate" | "delete" | "reorder" | "campaign_toggle" | "merge_execute" | "proposal_resolve" | "csv_import"
  changeClassification String   @default("minor_label") // "minor_label" | "material_meaning" | "lifecycle" | "config"
  beforeValue          String?  @db.Text
  afterValue           String?  @db.Text
  notes                String?  @db.Text
  createdAt            DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

model ConsentRecord {
  id            String   @id @default(uuid())
  submissionId  String
  participantId String?
  consentType   String   // "participation" | "communications"
  granted       Boolean
  policyVersion String   @default("v1.0")
  capturedAt    DateTime @default(now())
  ipHash        String?

  submission  SurveySubmission   @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  participant SurveyParticipant? @relation(fields: [participantId], references: [id], onDelete: SetNull)

  @@unique([submissionId, consentType])
  @@index([participantId, consentType])
}

model SurveyVerificationToken {
  id              String    @id @default(uuid())
  submissionId    String
  normalizedEmail String
  tokenHash       String    @unique // SHA-256 hex digest; raw token is never persisted
  expiresAt       DateTime
  consumedAt      DateTime?
  createdAt       DateTime  @default(now())

  submission SurveySubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@index([expiresAt])
}

model ReferralLink {
  id                     String   @id @default(uuid())
  code                   String   @unique
  campaignId             String
  createdByParticipantId String?
  label                  String?
  isActive               Boolean  @default(true)
  createdAt              DateTime @default(now())

  campaign    SurveyCampaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  createdBy   SurveyParticipant?   @relation(fields: [createdByParticipantId], references: [id], onDelete: SetNull)
  submissions SurveySubmission[]
  invitations ReferralInvitation[]

  @@unique([campaignId, createdByParticipantId])
  @@index([campaignId, isActive])
}

model ReferralInvitation {
  id                   String    @id @default(uuid())
  referralLinkId       String
  campaignId           String
  invitedPreferredName String?
  invitedEmail         String
  normalizedEmail      String
  status               String    @default("sent") // "sent" | "accepted" | "expired" | "suppressed" | "failed"
  invitedAt            DateTime  @default(now())
  acceptedAt           DateTime?

  referralLink ReferralLink   @relation(fields: [referralLinkId], references: [id], onDelete: Cascade)
  campaign     SurveyCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, normalizedEmail])
  @@index([referralLinkId])
}

model EmailSuppression {
  id              String   @id @default(uuid())
  normalizedEmail String   @unique
  reason          String   // "unsubscribed" | "bounced" | "complaint" | "manual"
  source          String?
  suppressedAt    DateTime @default(now())
}

model SurveyLeadInvite {
  id                  String    @id @default(uuid())
  campaignId          String
  leadId              String?
  outboxId            String?
  recipientEmail      String
  normalizedRecipient String
  recipientName       String?
  tokenHash           String    @unique
  expiresAt           DateTime
  openedAt            DateTime?
  lastOpenedAt        DateTime?
  openCount           Int       @default(0)
  completedAt         DateTime?
  submissionId        String?
  createdAt           DateTime  @default(now())

  lead LeadContact? @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([campaignId, normalizedRecipient])
  @@index([leadId])
  @@index([outboxId])
  @@index([expiresAt])
}

model LeadContact {
  id              String    @id @default(uuid())
  email           String
  normalizedEmail String    @unique
  fullName        String?
  institutionId   String?
  institutionName String?
  designation     String?
  source          String    @default("manual") // "manual" | "csv_import" | "referral" | "survey_submission" | "legacy_invite"
  sourceUrl       String?
  tagsJson        String    @default("[]") @db.Text
  notes           String?   @db.Text
  isArchived      Boolean   @default(false)
  archivedAt      DateTime?
  createdByUserId String?
  updatedByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  institution         Institution?             @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  campaignMemberships LeadCampaignMembership[]
  invites             SurveyLeadInvite[]
  auditLogs           LeadAuditLog[]

  @@index([isArchived, createdAt])
  @@index([institutionId])
  @@index([source])
}

model LeadCampaignMembership {
  id               String   @id @default(uuid())
  leadId           String
  campaignId       String
  assignedByUserId String?
  assignedAt       DateTime @default(now())

  lead     LeadContact    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  campaign SurveyCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([leadId, campaignId])
  @@index([campaignId])
}

model LeadAuditLog {
  id          String   @id @default(uuid())
  leadId      String?
  actorUserId String?
  actorEmail  String?
  action      String   // "created" | "updated" | "imported" | "exported" | "suppressed" | "unsuppressed" | "archived" | "unarchived" | "invite_queued" | "invite_resent" | "invite_cancelled" | "tags_updated" | "campaign_assigned"
  summary     String
  detailsJson String?  @db.Text
  createdAt   DateTime @default(now())

  lead LeadContact? @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
  @@index([createdAt])
}

model EmailConfig {
  id                      String    @id @default(uuid())
  status                  String    @default("draft") // "draft" | "active" | "archived"
  version                 Int       @default(1)

  // Outgoing SMTP
  smtpEnabled             Boolean   @default(false)
  smtpHost                String?
  smtpPort                Int       @default(587)
  smtpSecurity            String    @default("starttls") // "implicit_tls" | "starttls" | "none_dev_only"
  smtpAuthEnabled         Boolean   @default(true)
  smtpUsername            String?
  smtpPasswordEncrypted   String?   @db.Text
  smtpConnectionTimeoutMs Int       @default(10000)
  smtpRateLimitPerMinute  Int       @default(30)
  smtpMaxRetries          Int       @default(3)

  // Sender identity & routing
  fromDisplayName         String    @default("Global HRM Network")
  fromEmail               String?
  replyToEmail            String?
  supportEmail            String?
  footerText              String?   @db.Text
  websiteUrl              String?
  senderOverridesJson     String?   @db.Text

  // Incoming IMAP
  imapEnabled             Boolean   @default(false)
  imapHost                String?
  imapPort                Int       @default(993)
  imapSecurity            String    @default("implicit_tls") // "implicit_tls" | "starttls"
  imapUsername            String?
  imapPasswordEncrypted   String?   @db.Text
  imapFolder              String    @default("INBOX")
  imapPollingIntervalSec  Int       @default(120)
  imapInitialSyncMode     String    @default("after_activation") // "after_activation" | "last_7_days" | "last_30_days"
  imapRetentionDays       Int       @default(90)
  imapActivatedAt         DateTime?

  // Test verification & activation metadata
  lastSmtpTestAt          DateTime?
  lastSmtpTestSuccess     Boolean?
  lastSmtpTestMessage     String?   @db.Text
  lastSmtpTestedHash      String?
  lastImapTestAt          DateTime?
  lastImapTestSuccess     Boolean?
  lastImapTestMessage     String?   @db.Text
  lastImapTestedHash      String?
  activatedAt             DateTime?
  activatedByUserId       String?
  updatedByUserId         String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  auditLogs               EmailConfigAuditLog[]

  @@index([status, version])
}

model EmailConfigAuditLog {
  id          String   @id @default(uuid())
  configId    String?
  actorUserId String?
  actorEmail  String?
  action      String   // "draft_saved" | "smtp_password_replaced" | "smtp_password_removed" | "imap_password_replaced" | "imap_password_removed" | "smtp_tested" | "imap_tested" | "test_email_sent" | "activated" | "rolled_back"
  summary     String
  detailsJson String?  @db.Text
  createdAt   DateTime @default(now())

  config EmailConfig? @relation(fields: [configId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([configId])
}

model EmailThemeConfig {
  id                 String    @id @default(uuid())
  status             String    @default("draft") // "draft" | "published" | "archived"
  version            Int       @default(1)
  logoPath           String    @default("/email-assets/ghrm-email-logo.png")
  bannerPath         String    @default("/email-assets/ghrm-community-banner.jpg")
  primaryColor       String    @default("#0868B5")
  deepBlueColor      String    @default("#123B70")
  orangeAccent       String    @default("#F58220")
  greenAccent        String    @default("#8DBB32")
  paleBgColor        String    @default("#EFF6FC")
  bodyTextColor      String    @default("#263445")
  secondaryTextColor String    @default("#5C6B7A")
  surfaceColor       String    @default("#FFFFFF")
  headerStyle        String    @default("light_logo_ribbon")
  footerStyle        String    @default("corporate_ribbon")
  senderDisplayName  String    @default("Global HRM Network")
  supportEmail       String?
  websiteUrl         String    @default("https://www.global-hrm.net")
  tagline            String    @default("Connecting HR Leaders Worldwide")
  footerTagline      String    @default("Empowering HR Professionals to Connect, Learn & Grow Globally.")
  socialLinksJson    String    @default("[]") @db.Text
  updatedByUserId    String?
  updatedByEmail     String?
  publishedAt        DateTime?
  publishedByUserId  String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([status, version])
}

model EmailTemplate {
  id                   String    @id @default(uuid())
  emailType            String    @unique
  name                 String
  description          String
  classification       String    @default("transactional") // "transactional" | "community"
  variant              String    @default("transactional") // "transactional" | "community"
  status               String    @default("published") // "draft" | "published"
  version              Int       @default(1)
  subject              String
  preheader            String    @default("")
  eyebrow              String?
  heading              String
  greeting             String    @default("Hello {{preferred_name}},")
  bodyHtml             String    @db.Text
  bodyText             String    @db.Text
  infoPanelTitle       String?
  infoPanelBody        String?   @db.Text
  footerText           String    @db.Text
  ctaLabel             String?
  ctaUrlTemplate       String?
  bannerKey            String?
  requiredPlaceholders String    @db.Text // JSON array of required placeholder keys
  isCustomized         Boolean   @default(false)
  updatedByUserId      String?
  updatedByEmail       String?
  publishedAt          DateTime?
  publishedByUserId    String?
  publishedByEmail     String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  versions             EmailTemplateVersion[]
}

model EmailTemplateVersion {
  id             String   @id @default(uuid())
  templateId     String
  emailType      String
  version        Int
  status         String   @default("published") // "published" | "archived"
  snapshotJson   String   @db.Text
  changedByUserId String?
  changedByEmail String?
  createdAt      DateTime @default(now())

  template EmailTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId, version])
  @@index([emailType, version])
}

model EmailOutbox {
  id                    String    @id @default(uuid())
  businessKey           String    @unique
  emailType             String
  templateVersion       Int?
  campaignId            String?
  participantId         String?
  recipientEmail        String
  normalizedRecipient   String
  recipientName         String?
  fromAddress           String
  replyToAddress        String?
  subject               String
  htmlBody              String?   @db.Text
  textBody              String?   @db.Text
  containsSensitiveLink Boolean   @default(false)
  payloadExpiresAt      DateTime?
  status                String    @default("queued") // "queued" | "processing" | "accepted_by_smtp" | "temporarily_failed" | "permanently_failed" | "bounced" | "suppressed" | "delivered"
  attemptCount          Int       @default(0)
  maxAttempts           Int       @default(3)
  nextAttemptAt         DateTime  @default(now())
  lockedAt              DateTime?
  lockedBy              String?
  messageId             String?   @unique
  smtpResponse          String?   @db.Text
  lastError             String?   @db.Text
  sentAt                DateTime?
  deliveredAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([status, nextAttemptAt])
  @@index([emailType, createdAt])
  @@index([normalizedRecipient])
  @@index([campaignId])
}

model ImapMailboxCursor {
  id               String    @id @default(uuid())
  mailboxKey       String    @unique
  folder           String
  uidValidity      BigInt?
  lastProcessedUid Int       @default(0)
  lastPolledAt     DateTime?
  lastError        String?   @db.Text
  updatedAt        DateTime  @updatedAt
}

model InboundEmailMessage {
  id                     String   @id @default(uuid())
  mailboxKey             String
  folder                 String
  uidValidity            BigInt
  uid                    Int
  messageId              String?
  inReplyTo              String?
  referencesHeader       String?  @db.Text
  fromAddress            String?
  fromName               String?
  toAddress              String?
  subject                String?
  receivedAt             DateTime
  processingStatus       String   @default("received") // "received" | "correlated" | "dsn_bounce_correlated" | "ignored" | "error"
  textPreview            String?  @db.Text
  sanitizedHtml          String?  @db.Text
  attachmentMetadataJson String?  @db.Text
  sizeBytes              Int      @default(0)
  relatedOutboxId        String?
  relatedParticipantId   String?
  createdAt              DateTime @default(now())

  @@unique([mailboxKey, folder, uidValidity, uid])
  @@index([receivedAt])
  @@index([messageId])
  @@index([inReplyTo])
  @@index([relatedOutboxId])
}

model AiApiKey {
  id              String    @id @default(uuid())
  provider        String    @default("groq") // "groq" | "openai" | "anthropic" | "gemini" | "custom"
  label           String
  encryptedKey    String    @db.Text
  keyPreview      String
  defaultModel    String?
  baseUrl         String?
  isActive        Boolean   @default(true)
  isDefault       Boolean   @default(false)
  lastTestedAt    DateTime?
  lastTestStatus  String?   // "ok" | "error"
  lastTestMessage String?   @db.Text
  lastUsedAt      DateTime?
  createdByUserId String?
  updatedByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  auditLogs AiApiKeyAuditLog[]

  @@index([provider, isActive])
  @@index([provider, isDefault])
}

model AiApiKeyAuditLog {
  id          String   @id @default(uuid())
  apiKeyId    String?
  provider    String
  label       String
  actorUserId String?
  actorEmail  String?
  action      String   // "created" | "updated" | "rotated" | "activated" | "deactivated" | "set_default" | "tested" | "deleted"
  summary     String
  createdAt   DateTime @default(now())

  apiKey AiApiKey? @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)

  @@index([apiKeyId, createdAt])
  @@index([createdAt])
}
